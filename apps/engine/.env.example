# `npm run env` im Projektordner legt die .env an und trägt die Supabase-Werte ein.
# Die .env gehört nicht ins Repo.

# Lokales Supabase (Standardwert von `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321

# Ab Phase 1: Key aus der Claude Console, am besten aus einem eigenen Workspace mit Ausgabenlimit
ANTHROPIC_API_KEY=
