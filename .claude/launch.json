{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "engine",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "apps/engine",
        "uvicorn",
        "engine.main:app",
        "--reload",
        "--reload-dir",
        "src",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
